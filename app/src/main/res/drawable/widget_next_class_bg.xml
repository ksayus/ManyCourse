<?xml version="1.0" encoding="utf-8"?>
<!--
  小组件底板：圆角 + 1dp 描边。

  为什么不用 MaterialCardView / 主题属性：桌面小组件跑在**桌面的进程**里，
  那里没有我们 App 的 Theme，`?attr/colorSurface` 这类主题属性解析不到（会直接崩或渲染成透明）。
  所以这里只用 `@color/widget_*` 这种**固定色值**，深色模式靠 `values-night/colors.xml`
  同名覆盖 —— 见 `values/colors.xml` 里那一段注释。
-->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <solid android:color="@color/widget_surface" />
    <corners android:radius="22dp" />
    <stroke
        android:width="1dp"
        android:color="@color/widget_stroke" />
</shape>
