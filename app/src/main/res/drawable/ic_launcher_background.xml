<?xml version="1.0" encoding="utf-8"?>
<!--
  自适应图标的背景层（108dp 画布）。

  正常情况下这一层被前景完全盖住 —— 前景是满幅不透明的位图（见
  tools/make_launcher_icons.ps1 里"垫一张 1.4 倍的自己"那段）。它只在两种时刻露出来：
    ① 启动器做视差：长按拖动图标时前景会随手指轻移几个 dp，边缘会错开；
    ② 遮罩形状偏方时，露到了设计图自己那圈圆角之外。
  所以这里的渐变刻意跟着图标本身的走向（左上浅蓝 → 右下深蓝），错开时接缝才看不出来。
  配色取自设计图：顶部 #75A1F6、左侧 #3173F1、右下 #2251C1。
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">
    <path android:pathData="M0,0h108v108h-108z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:endX="108"
                android:endY="108"
                android:startX="0"
                android:startY="0"
                android:type="linear">
                <item
                    android:color="#75A1F6"
                    android:offset="0" />
                <item
                    android:color="#2251C1"
                    android:offset="1" />
            </gradient>
        </aapt:attr>
    </path>
</vector>
