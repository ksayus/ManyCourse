<?xml version="1.0" encoding="utf-8"?>
<!--
  学校下拉弹窗（弹窗是独立 Window，不吃玻璃卡片的背景，
  所以需要自己的底色/描边令牌，否则在浅色玻璃上会糊成一片）。
  夜间模式在 values-night/colors.xml 覆盖同名令牌。
-->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <solid android:color="@color/login_dropdown_bg" />
    <corners android:radius="16dp" />
    <stroke
        android:width="1dp"
        android:color="@color/login_dropdown_stroke" />
</shape>
