<?xml version="1.0" encoding="utf-8"?>
<!--
  登录页设计令牌（浅色）。夜间模式在 values-night/colors.xml 覆盖同名字段，
  所有 drawable 与布局都引用这里，避免硬编码颜色导致夜间模式失效。
-->
<resources>
    <color name="purple_200">#FFBB86FC</color>
    <color name="purple_500">#FF6200EE</color>
    <color name="purple_700">#FF3700B3</color>
    <color name="teal_200">#FF03DAC5</color>
    <color name="teal_700">#FF018786</color>
    <color name="black">#FF000000</color>
    <color name="white">#FFFFFFFF</color>

    <!-- 页面背景渐变（与 Compose 侧 glassTokens.backgroundGradient 取值一致） -->
    <color name="login_bg_start">#DCEAFF</color>
    <color name="login_bg_center">#F5F9FF</color>
    <color name="login_bg_end">#E8F0FE</color>

    <!-- 装饰光斑 -->
    <color name="login_blob_blue_start">#4D90CAF9</color>
    <color name="login_blob_blue_center">#1A90CAF9</color>
    <color name="login_blob_blue_end">#0090CAF9</color>
    <color name="login_blob_purple_start">#407C4DFF</color>
    <color name="login_blob_purple_center">#147C4DFF</color>
    <color name="login_blob_purple_end">#007C4DFF</color>

    <!-- 图标玻璃底座 -->
    <color name="login_icon_disc">#59FFFFFF</color>
    <color name="login_icon_stroke">#8CFFFFFF</color>

    <!-- 文本 -->
    <color name="login_title">#0D47A1</color>
    <color name="login_info_error">#D32F2F</color>
    <color name="login_info_ok">#2E7D32</color>

    <!-- 玻璃卡片 -->
    <color name="login_card_bg">#D9FFFFFF</color>
    <color name="login_card_stroke">#80FFFFFF</color>

    <!-- 输入框：比卡片略深一档，形成清晰的"输入区"层级 -->
    <color name="login_field_bg">#EAF1FC</color>
    <color name="login_field_stroke">#93B4E8</color>
    <color name="login_field_stroke_focused">#1976D2</color>
    <color name="login_field_text">#0D47A1</color>
    <color name="login_field_hint">#1976D2</color>
    <color name="login_field_icon">#1976D2</color>
    <color name="login_field_highlight">#BBDEFB</color>

    <!-- 登录按钮 -->
    <color name="login_button_start">#1E88E5</color>
    <color name="login_button_end">#0D47A1</color>
    <color name="login_button_ripple">#64B5F6</color>

    <!-- 学校下拉弹窗：弹窗是独立 Window，衬在页面渐变上，必须接近不透明才看得清 -->
    <color name="login_dropdown_bg">#F7FFFFFF</color>
    <color name="login_dropdown_stroke">#331976D2</color>

    <!--
      桌面小组件（2x2「下一节课」）。RemoteViews **不支持主题属性**（`?attr/colorSurface` 这类
      在桌面进程里解析不到），所以只能用固定色值 + `values-night` 同名覆盖来适配深色模式。
      引用处：`res/drawable/widget_next_class_bg.xml`、
      `res/drawable/widget_next_class_bg_liquid.xml` 与 `res/layout/widget_next_class.xml`。

      ★ 下面这一组 `widget_glass_*` 是**玻璃令牌的真实取值**，不是另编的一套
      （来源 `ui/theme/GlassTokens.kt` 的 glassTokens()，这里是 `GlassMode.Gaussian`）：
        · surface          ← barTint       白 52%（深色 #0F172A 62%）
        · highlight_top/mid← highlight    白 14% → 2%（深色 6% → 2%）
        · border           ← border       白 50%（深色 白 12%）；Liquid 为白 72% / 白 18%
      为什么用 barTint 而不是 cardTint：小组件是**2x2 的大表面**（页头/底栏那一档），
      卡片那一档（78% 白）是给列表里的重复项用的。Liquid 的那份在同名 drawable
      `widget_next_class_bg_liquid.xml` 里给（同一命名口径），由 WidgetRefresh 按设置切换。
    -->
    <color name="widget_surface">#F2FFFFFF</color>
    <color name="widget_stroke">#1A0D47A1</color>
    <color name="widget_label">#FF5B6B7F</color>
    <color name="widget_name">#FF0D1B2A</color>
    <color name="widget_meta">#FF44566C</color>
    <color name="widget_room">#FF2E6DB4</color>
    <color name="widget_status">#FF1E88E5</color>
    <color name="widget_muted">#FF8A97A6</color>
    <!-- 例假/正在上课时状态行的强调色 -->
    <color name="widget_live">#FF2E7D32</color>

    <!-- 玻璃令牌镜像（Gaussian × 浅色）：半透明底 + 顶部柔光 + 1dp 亮边 + 内侧同色系着色 -->
    <color name="widget_glass_surface">#85FFFFFF</color>
    <color name="widget_glass_highlight_top">#24FFFFFF</color>
    <color name="widget_glass_highlight_mid">#05FFFFFF</color>
    <color name="widget_glass_border">#80FFFFFF</color>
    <!-- innerTint：CampusBlue600 的 5%（令牌 values.innerTintLight） -->
    <color name="widget_glass_inner_tint">#0D1565C0</color>

    <!-- 玻璃令牌镜像（Liquid × 浅色）：更通透的底、更强的高光与边缘光、加一层内阴影 -->
    <color name="widget_glass_liquid_surface">#75FFFFFF</color>
    <color name="widget_glass_liquid_highlight_top">#4DFFFFFF</color>
    <color name="widget_glass_liquid_highlight_mid">#0FFFFFFF</color>
    <color name="widget_glass_liquid_highlight_end">#05FFFFFF</color>
    <color name="widget_glass_liquid_border">#99FFFFFF</color>
    <color name="widget_glass_liquid_inner_shadow">#0D000000</color>
</resources>

